+// ---- Widescreen (16:9, 512x224) variant of ssf2t (World 940223) ----
+// Patches are applied to the decrypted program in memory after load. Each patch
+// is verified against the expected original word first; if the ROM revision does
+// not match, nothing is patched (widescreen view only).
+struct WsPatch { UINT32 addr; UINT16 orig; UINT16 val; INT32 data; };
+#include "ssf2tws_patches.h"
+
+static INT32 Ssf2twsApplyPatches()
+{
+	INT32 n = 0, bad = 0;
+	for (INT32 i = 0; Ssf2twsPatches[i].addr; i++) {
+		UINT8 *b = Ssf2twsPatches[i].data ? CpsRom : CpsCode;
+		UINT16 *w = (UINT16*)(b + Ssf2twsPatches[i].addr);
+		if (BURN_ENDIAN_SWAP_INT16(*w) != Ssf2twsPatches[i].orig) {
+			bprintf(PRINT_ERROR, _T("ssf2tws: mismatch at %06x: %04x\n"), Ssf2twsPatches[i].addr, BURN_ENDIAN_SWAP_INT16(*w));
+			bad++;
+		}
+		n++;
+	}
+	if (bad) { bprintf(PRINT_ERROR, _T("ssf2tws: %d of %d patch sites do not match, game patches skipped\n"), bad, n); return 1; }
+	for (INT32 i = 0; Ssf2twsPatches[i].addr; i++) {
+		UINT8 *b = Ssf2twsPatches[i].data ? CpsRom : CpsCode;
+		UINT16 *w = (UINT16*)(b + Ssf2twsPatches[i].addr);
+		*w = BURN_ENDIAN_SWAP_INT16(Ssf2twsPatches[i].val);
+	}
+	bprintf(PRINT_NORMAL, _T("ssf2tws: applied %d widescreen patch words\n"), n);
+	return 0;
+}
+
+// Outside fights the game only draws the middle 384 px, so the side strips would show stale
+// video memory. When the camera object (0xFF8ECE) is inactive, fill each strip per row with the
+// screen's solid background colour if that edge is a solid colour, otherwise with black.
+#define SSF2TWS_SEL_LAYERS 0x08   // select screen: scroll3 = patterned background (portraits are scroll2)
+#define SSF2TWS_BG_LAYERS 0x0c   // scroll2 + scroll3 (portraits are sprites, text is scroll1)
+// Mirror the background layers (bgmask) of the original picture's outer 64 px into each strip.
+// With keepsprites, the game's own sprite pixels in the strips are drawn on top.
+static void Ssf2twsMirrorStrips(INT32 bgmask, INT32 keepsprites, INT32 wrap = 0)
+{
+	const INT32 H = nCpsScreenHeight, bpp = nBurnBpp;
+	const INT32 side = (nCpsScreenWidth - 384) / 2;
+		static UINT8 *bg = NULL; static INT32 bgsize = 0;
+		INT32 need = nBurnPitch * H;
+		if (need > bgsize) { if (bg) BurnFree(bg); bg = (UINT8*)BurnMalloc(need); bgsize = need; }
+		if (bg) {
+			INT32 mask = bgmask;
+			static UINT8 *spr = NULL, *clr = NULL; static INT32 sprsize = 0;
+			if (need > sprsize) { if (spr) BurnFree(spr); if (clr) BurnFree(clr); spr = (UINT8*)BurnMalloc(need); clr = (UINT8*)BurnMalloc(need); sprsize = need; }
+			UINT8 *save = pBurnDraw; INT32 saveLayer = nBurnLayer;
+			pBurnDraw = bg; nBurnLayer = mask; CpsDraw();           // background layers only
+			if (spr && clr && keepsprites) {
+				pBurnDraw = spr; nBurnLayer = 1; CpsDraw();         // sprites only
+				pBurnDraw = clr; nBurnLayer = 0; CpsDraw();         // nothing (backdrop only)
+			}
+			pBurnDraw = save; nBurnLayer = saveLayer;
+			for (INT32 y = 0; y < H; y++) {
+				UINT8 *row = pBurnDraw + y * nBurnPitch, *src = bg + y * nBurnPitch;
+				UINT8 *sp = (spr && keepsprites) ? spr + y * nBurnPitch : NULL, *cl = clr ? clr + y * nBurnPitch : NULL;
+				// a sprite pixel counts only if a vertical neighbour is a sprite pixel too (drops
+				// stray 1-px lines of off-screen sprites the game never meant to be seen)
+				#define SSF2TWS_SPR(xx) (memcmp(sp + (xx) * bpp, cl + (xx) * bpp, bpp) && \
+					((y > 0 && memcmp(sp - nBurnPitch + (xx) * bpp, cl - nBurnPitch + (xx) * bpp, bpp)) || \
+					 (y + 1 < H && memcmp(sp + nBurnPitch + (xx) * bpp, cl + nBurnPitch + (xx) * bpp, bpp))))
+				for (INT32 x = 0; x < side; x++) {
+					INT32 lx = x, rx = side + 384 + x;
+					// keep the game's own sprite pixels (characters sliding in), else mirrored background
+					if (sp && SSF2TWS_SPR(lx)) memcpy(row + lx * bpp, sp + lx * bpp, bpp);
+					else memcpy(row + lx * bpp, src + (wrap ? (lx + 384) : (2 * side - 1 - x)) * bpp, bpp);
+					if (sp && SSF2TWS_SPR(rx)) memcpy(row + rx * bpp, sp + rx * bpp, bpp);
+					else memcpy(row + rx * bpp, src + (wrap ? (rx - 384) : (side + 384 - 1 - x)) * bpp, bpp);
+				}
+				#undef SSF2TWS_SPR
+			}
+		}
+}
+
+
+// "Next Fighter" screen (one-player mode, between fights): same background as character select.
+static INT32 Ssf2twsIsNextFighter()
+{
+	return CpsRamFF[0x8009 ^ 1] == 2 && CpsRamFF[0x8005 ^ 1] == 4 &&
+	       *(UINT16*)(CpsRamFF + 0x8060) == 0xffc0 && *(UINT16*)(CpsRamFF + 0x8062) == 0x0300 &&
+	       *(UINT16*)(CpsRamFF + 0x8064) == 0xffc0 && *(UINT16*)(CpsRamFF + 0x8066) == 0x06f0;
+}
+
+// VS screen (in a game: 0xFF8009 == 4; in attract mode: 0xFF8009 == 2 with the VS layer setup).
+// The game draws its background full width, so it is left untouched.
+static INT32 Ssf2twsIsVS()
+{
+	if (CpsRamFF[0x8009 ^ 1] == 4) return 1;
+	// continue-screen background still up (continue, game over, high score initials entry)
+	if (CpsRamFF[0x8ece ^ 1] == 0 &&
+	    *(UINT16*)(CpsRamFF + 0x8060) == 0xffc0 && *(UINT16*)(CpsRamFF + 0x8062) == 0x0300 &&
+	    *(UINT16*)(CpsRamFF + 0x8064) == 0x0620 && *(UINT16*)(CpsRamFF + 0x8066) == 0x03e0) return 1;
+	if (Ssf2twsIsNextFighter()) return 0;
+	// defeat / win-quote (0xFF8005 == 8) and continue (== 10) screens: also drawn full width
+	// (the attract intro also passes through 0xFF8005 == 8 / 10, e.g. Akuma's scene, but always with
+	//  0xFF8009 == 2 and the camera off; the defeat screen only starts with 8009 == 2 while the camera is on)
+	// (the attract intro also passes through 0xFF8005 == 8 / 10, e.g. Akuma's scene, but with other
+	//  layer positions; the defeat / continue / initials screens always have scroll2 at (FFC0, 0300))
+	// (scroll2 Y can be off by a few pixels while the screen shakes, e.g. on the initials screen)
+	if ((CpsRamFF[0x8005 ^ 1] == 8 || CpsRamFF[0x8005 ^ 1] == 10) && *(UINT16*)(CpsRamFF + 0x8060) == 0xffc0 &&
+	    *(UINT16*)(CpsRamFF + 0x8062) >= 0x02f0 && *(UINT16*)(CpsRamFF + 0x8062) <= 0x0310) return 1;
+	// game over (screen dims after the continue count reaches 0): the continue screen's layers stay up
+	if (CpsRamFF[0x8005 ^ 1] == 0 && CpsRamFF[0x8009 ^ 1] == 0 && *(UINT16*)(CpsRamFF + 0x805e) == 0x0100 &&
+	    *(UINT16*)(CpsRamFF + 0x8060) == 0xffc0 && *(UINT16*)(CpsRamFF + 0x8062) == 0x0300) return 1;
+	return CpsRamFF[0x8009 ^ 1] == 2 && CpsRamFF[0x8005 ^ 1] == 4 &&
+	       *(UINT16*)(CpsRamFF + 0x8060) == 0xffc0 && *(UINT16*)(CpsRamFF + 0x8062) == 0x0300;
+}
+
+static void Ssf2twsMaskStripsRaw()
+{
+	if (pBurnDraw == NULL || nCpsScreenWidth < 448 + 8) return;
+	if ((CpsRamFF[0x8ece ^ 1] == 1 && CpsRamFF[0x8005 ^ 1] <= 8) || (CpsRamFF[0x8005 ^ 1] == 4 && CpsRamFF[0x8009 ^ 1] >= 6)) return;   // fight: keep full width
+	if (Ssf2twsIsVS()) return;   // VS screen: the game draws its background full width
+
+	const INT32 W = nCpsScreenWidth, H = nCpsScreenHeight, bpp = nBurnBpp;
+	const INT32 side = (W - 384) / 2;                 // 64
+
+	// Cammy / Chun-Li intro scenes: mirror the picture's outer 64 px into each strip
+	// (background layers only: the frame is re-rendered without the portrait layer into a scratch
+	//  buffer, and the strips are mirrored from that, so the characters are never mirrored)
+	if (CpsRamFF[0x02d7 ^ 1] == 240 && CpsRamFF[0x02e7 ^ 1] == 12 && CpsRamFF[0x8005 ^ 1] == 2 && CpsRamFF[0x8009 ^ 1] == 2) {
+		Ssf2twsMirrorStrips(SSF2TWS_BG_LAYERS, 1);
+		return;
+	}
+	// Next Fighter screen: tile the background like character select. The portrait row's band
+	// (rows 160-191) would repeat the portraits, so there the strips take the background pattern
+	// from one pattern period (192 px) further up the same layer, which continues it seamlessly.
+	if (Ssf2twsIsNextFighter()) {
+		Ssf2twsMirrorStrips(SSF2TWS_SEL_LAYERS, 0, 1);
+		static UINT8 *up = NULL; static INT32 upsize = 0;
+		INT32 need = nBurnPitch * H;
+		if (need > upsize) { if (up) BurnFree(up); up = (UINT8*)BurnMalloc(need); upsize = need; }
+		if (up) {
+			UINT8 *save = pBurnDraw; INT32 sl = nBurnLayer;
+			UINT16 *ry = (UINT16*)(CpsSaveReg[0] + 0x16), oy = *ry;   // scroll3 Y
+			*ry = BURN_ENDIAN_SWAP_INT16(BURN_ENDIAN_SWAP_INT16(oy) - 192);
+			pBurnDraw = up; nBurnLayer = SSF2TWS_SEL_LAYERS; CpsDraw();
+			*ry = oy; pBurnDraw = save; nBurnLayer = sl;
+			for (INT32 y = 160; y <= 191 && y < H; y++) {
+				UINT8 *row = pBurnDraw + y * nBurnPitch, *src = up + y * nBurnPitch;
+				memcpy(row, src + 384 * bpp, side * bpp);                       // same 384 px tiling as above
+				memcpy(row + (side + 384) * bpp, src + side * bpp, side * bpp);
+			}
+		}
+		return;
+	}
+	// Character select: identified by the game's default scroll setup outside gameplay
+	if ((CpsRamFF[0x8009 ^ 1] == 0 || CpsRamFF[0x8009 ^ 1] == 6) &&   // select screen (attract, new game, after a continue)
+	    *(UINT16*)(CpsRamFF + 0x8060) == 0xffc0 && *(UINT16*)(CpsRamFF + 0x8062) == 0x0300 &&
+	    *(UINT16*)(CpsRamFF + 0x8064) == 0xffc0 && *(UINT16*)(CpsRamFF + 0x8066) == 0x06f0) {
+		INT32 m = SSF2TWS_SEL_LAYERS;
+		Ssf2twsMirrorStrips(m, 0, 1);   // background is designed to tile every 384 px
+		return;
+	}
+	for (INT32 s = 0; s < 2; s++) {
+		const INT32 sx = s ? (side + 384 - 8) : side;    // 8-px sample just inside the original edge
+		const INT32 fx = s ? (side + 384) : 0;           // first strip column
+		UINT32 colours[224]; UINT8 uni[224]; INT32 nuni = 0;
+		for (INT32 y = 0; y < H && y < 224; y++) {
+			UINT8 *row = pBurnDraw + y * nBurnPitch;
+			UINT32 c0 = 0; memcpy(&c0, row + sx * bpp, bpp);
+			uni[y] = 1;
+			for (INT32 x = 1; x < 8; x++) { UINT32 c = 0; memcpy(&c, row + (sx + x) * bpp, bpp); if (c != c0) { uni[y] = 0; break; } }
+			colours[y] = c0; nuni += uni[y];
+		}
+		UINT32 dom = 0;
+		INT32 solid = nuni * 4 >= H * 3;                 // >= 75% of rows solid -> solid-colour screen
+		if (solid) {                                     // most common solid edge colour
+			INT32 best = 0;
+			for (INT32 y = 0; y < H && y < 224; y++) if (uni[y]) {
+				INT32 n = 0; for (INT32 z = 0; z < H && z < 224; z++) if (uni[z] && colours[z] == colours[y]) n++;
+				if (n > best) { best = n; dom = colours[y]; }
+			}
+		}
+		for (INT32 y = 0; y < H && y < 224; y++) {
+			UINT8 *row = pBurnDraw + y * nBurnPitch;
+			// in-game screens (VS screen etc.): per-row edge colour; attract/title: one colour (no streaks)
+			UINT32 c = solid ? ((CpsRamFF[0x8009 ^ 1] == 2 || !uni[y]) ? dom : colours[y]) : 0;   // attract (8009==2): one colour; elsewhere per-row as before
+			for (INT32 x = 0; x < side; x++) memcpy(row + (fx + x) * bpp, &c, bpp);
+		}
+	}
+}
+
+
+// In fights: pixels in the side strips that no layer covers (backdrop showing through, e.g. the
+// edges of Dee Jay's stage) are filled by mirroring the stage background (layers only, no
+// sprites) across the edge of the gap, row by row.
+static void Ssf2twsFillFightHoles()
+{
+	if (pBurnDraw == NULL || nCpsScreenWidth < 448 + 8) return;
+	const INT32 W = nCpsScreenWidth, H = nCpsScreenHeight, bpp = nBurnBpp, side = (W - 384) / 2;
+	static UINT8 *clr = NULL, *lay = NULL; static INT32 sz = 0;
+	INT32 need = nBurnPitch * H;
+	if (need > sz) { if (clr) BurnFree(clr); if (lay) BurnFree(lay); clr = (UINT8*)BurnMalloc(need); lay = (UINT8*)BurnMalloc(need); sz = need; }
+	if (!clr || !lay) return;
+	UINT8 *save = pBurnDraw; INT32 saveLayer = nBurnLayer;
+	pBurnDraw = clr; nBurnLayer = 0; CpsDraw();                 // backdrop only
+	pBurnDraw = save; nBurnLayer = saveLayer;
+	UINT32 bd = 0; memcpy(&bd, clr, bpp);
+	// any holes in the strips?
+	INT32 holes = 0;
+	for (INT32 y = 0; y < H && !holes; y++) {
+		UINT8 *row = pBurnDraw + y * nBurnPitch;
+		for (INT32 x = 0; x < side && !holes; x++) {
+			UINT32 a = 0, b = 0; memcpy(&a, row + x * bpp, bpp); memcpy(&b, row + (W - 1 - x) * bpp, bpp);
+			if (a == bd || b == bd) holes = 1;
+		}
+	}
+	if (!holes) return;
+	// a hole means the bottom-most layer has no art there: mirror only that layer (mirroring the
+	// layers in front of it as well would duplicate their objects into the gap)
+	INT32 holemask = 0x0e;
+	{
+		UINT16 lc = BURN_ENDIAN_SWAP_INT16(*((UINT16 *)(CpsSaveReg[0] + nCpsLcReg)));
+		for (INT32 i = 0; i < 4; i++) {
+			INT32 l = (lc >> (6 + 2 * i)) & 3;                  // bottom .. top
+			if (l > 0 && (lc & CpsLayEn[l])) { holemask = 1 << l; break; }
+		}
+	}
+	pBurnDraw = lay; nBurnLayer = holemask; CpsDraw();          // bottom background layer only
+	pBurnDraw = save; nBurnLayer = saveLayer;
+	for (INT32 y = 0; y < H; y++) {
+		UINT8 *row = pBurnDraw + y * nBurnPitch, *src = lay + y * nBurnPitch;
+		// mirror the bottom layer across the edge of its own art in this row (a straight edge, so
+		// the mirrored part continues it without steps)
+		INT32 L = W / 2, R = W / 2 - 1;
+		for (; L > 0; L--) { UINT32 v = 0; memcpy(&v, src + (L - 1) * bpp, bpp); if (v == bd) break; }
+		for (; R < W - 1; R++) { UINT32 v = 0; memcpy(&v, src + (R + 1) * bpp, bpp); if (v == bd) break; }
+		if (R < L) continue;
+		for (INT32 k = 0; k < 2 * side; k++) {
+			INT32 x = k < side ? k : W - 2 * side + k;
+			UINT32 c = 0; memcpy(&c, row + x * bpp, bpp);
+			if (c != bd) continue;
+			INT32 sx = (x < L) ? 2 * L - 1 - x : (x > R) ? 2 * R + 1 - x : -1;
+			if (sx < L || sx > R) continue;
+			UINT32 v = 0; memcpy(&v, src + sx * bpp, bpp);
+			if (v != bd) memcpy(row + x * bpp, &v, bpp);
+		}
+	}
+	for (INT32 pass = 0; pass < 2; pass++) {
+		for (INT32 y = 0; y < H; y++) {
+			INT32 yy = pass ? (H - 1 - y) : y, ny = pass ? yy + 1 : yy - 1;
+			if (ny < 0 || ny >= H) continue;
+			UINT8 *row = pBurnDraw + yy * nBurnPitch, *nb = pBurnDraw + ny * nBurnPitch;
+			for (INT32 k = 0; k < 2 * side; k++) {
+				INT32 x = k < side ? k : W - 2 * side + k;
+				UINT32 c = 0, d = 0; memcpy(&c, row + x * bpp, bpp); memcpy(&d, nb + x * bpp, bpp);
+				if (c == bd && d != bd) memcpy(row + x * bpp, &d, bpp);
+			}
+		}
+	}
+}
+
+// Super Combo finish: the burst (scroll2/scroll3) is drawn only in the middle 384 px. Re-compose
+// the frame: the burst layers' middle 384 px stretched horizontally to the full width, with the
+// sprites (fighters, "SUPER COMBO FINISH" text) and scroll1 (HUD) drawn unscaled on top.
+static void Ssf2twsStretchFinish()
+{
+	if (pBurnDraw == NULL || nCpsScreenWidth < 448 + 8) return;
+	const INT32 W = nCpsScreenWidth, H = nCpsScreenHeight, bpp = nBurnBpp, side = (W - 384) / 2;
+	static UINT8 *bg = NULL, *fg = NULL, *clr = NULL; static INT32 sz = 0;
+	INT32 need = nBurnPitch * H;
+	if (need > sz) {
+		if (bg) BurnFree(bg); if (fg) BurnFree(fg); if (clr) BurnFree(clr);
+		bg = (UINT8*)BurnMalloc(need); fg = (UINT8*)BurnMalloc(need); clr = (UINT8*)BurnMalloc(need); sz = need;
+	}
+	if (!bg || !fg || !clr) return;
+	UINT8 *save = pBurnDraw; INT32 saveLayer = nBurnLayer;
+	// Foreground = whatever the hardware draws above the burst layers (scroll2/3): sprites whose
+	// priority level is above theirs (same rules as Cps2Layers), and scroll1 only if it is on top.
+	UINT16 lc = BURN_ENDIAN_SWAP_INT16(*((UINT16 *)(CpsSaveReg[0] + nCpsLcReg)));
+	INT32 lp = (CpsSaveFrg[0][4] << 8) | CpsSaveFrg[0][5];
+	INT32 draw[4] = { (lc >> 6) & 3, (lc >> 8) & 3, (lc >> 10) & 3, (lc >> 12) & 3 };   // bottom .. top
+	INT32 prio[4] = { 0, (lp >> 4) & 7, (lp >> 8) & 7, (lp >> 12) & 7 };
+	for (INT32 i = 3, hi = 9999; i >= 0; i--) if (draw[i] > 0) { if (prio[draw[i]] > hi) prio[draw[i]] = hi; else hi = prio[draw[i]]; }
+	INT32 pmax = 0, top = -1, s1pos = -1;
+	for (INT32 i = 0; i < 4; i++) {
+		if (draw[i] == 2 || draw[i] == 3) { if (prio[draw[i]] > pmax) pmax = prio[draw[i]]; top = i; }
+		if (draw[i] == 1) s1pos = i;
+	}
+	INT32 fgmask = 0x01 | ((s1pos > top && (lc & CpsLayEn[1])) ? 0x02 : 0);
+	UINT32 saveSpr = nSpriteEnable;
+	pBurnDraw = bg;  nBurnLayer = 0x0c; nSpriteEnable = 0; CpsDraw();                        // burst layers
+	pBurnDraw = fg;  nBurnLayer = fgmask; nSpriteEnable = saveSpr & (0xff << (pmax + 1)); CpsDraw();   // foreground
+	pBurnDraw = clr; nBurnLayer = 0x00; nSpriteEnable = 0; CpsDraw();                        // backdrop only
+	pBurnDraw = save; nBurnLayer = saveLayer; nSpriteEnable = saveSpr;
+	for (INT32 y = 0; y < H; y++) {
+		UINT8 *row = pBurnDraw + y * nBurnPitch, *b = bg + y * nBurnPitch, *f = fg + y * nBurnPitch, *c = clr + y * nBurnPitch;
+		for (INT32 x = 0; x < W; x++) {
+			INT32 isfg = memcmp(f + x * bpp, c + x * bpp, bpp) != 0;
+			if (isfg && (x < side || x >= side + 384)) {      // strips: drop stray 1-px lines of off-screen sprites
+				isfg = (y > 0 && memcmp(f - nBurnPitch + x * bpp, c - nBurnPitch + x * bpp, bpp)) ||
+				       (y + 1 < H && memcmp(f + nBurnPitch + x * bpp, c + nBurnPitch + x * bpp, bpp));
+			}
+			if (isfg) { memcpy(row + x * bpp, f + x * bpp, bpp); continue; }
+			// source position in the middle 384 px, in quarter pixels: 4*side + 3*x (scale 384/512)
+			INT32 q = 4 * side + 3 * x + 1, sx = q >> 2, fr = q & 3;   // +1: sample pixel centres
+			if (sx >= side + 383) { sx = side + 383; fr = 0; }
+			if (bpp == 4 && fr) {
+				UINT32 p0 = ((UINT32*)b)[sx], p1 = ((UINT32*)b)[sx + 1];
+				UINT32 rb = ((p0 & 0xff00ff) * (4 - fr) + (p1 & 0xff00ff) * fr) >> 2 & 0xff00ff;
+				UINT32 g  = ((p0 & 0x00ff00) * (4 - fr) + (p1 & 0x00ff00) * fr) >> 2 & 0x00ff00;
+				((UINT32*)row)[x] = rb | g;
+			} else {
+				memcpy(row + x * bpp, b + (sx + (fr >= 2)) * bpp, bpp);
+			}
+		}
+	}
+}
+
+// Fei Long's stage: the near rock / waterfall layer (scroll1) ends before the right edge of the
+// 16:9 view near the camera's right limit. Mirror that layer across its own right edge, row by
+// row, wherever nothing in front of it (scroll2, sprites) covers the pixel.
+static void Ssf2twsFeiLongFill()
+{
+	if (pBurnDraw == NULL || nCpsScreenWidth < 448 + 8) return;
+	const INT32 W = nCpsScreenWidth, H = nCpsScreenHeight, bpp = nBurnBpp;
+	static UINT8 *l1 = NULL, *fr = NULL, *clr = NULL; static INT32 sz = 0;
+	INT32 need = nBurnPitch * H;
+	if (need > sz) {
+		if (l1) BurnFree(l1); if (fr) BurnFree(fr); if (clr) BurnFree(clr);
+		l1 = (UINT8*)BurnMalloc(need); fr = (UINT8*)BurnMalloc(need); clr = (UINT8*)BurnMalloc(need); sz = need;
+	}
+	if (!l1 || !fr || !clr) return;
+	UINT8 *save = pBurnDraw; INT32 sl = nBurnLayer;
+	pBurnDraw = clr; nBurnLayer = 0x00; CpsDraw();     // backdrop only
+	pBurnDraw = l1;  nBurnLayer = 0x02; CpsDraw();     // scroll1 only
+	pBurnDraw = fr;  nBurnLayer = 0x05; CpsDraw();     // sprites + scroll2 (in front)
+	pBurnDraw = save; nBurnLayer = sl;
+	for (INT32 y = 0; y < H; y++) {
+		UINT8 *a = l1 + y * nBurnPitch, *c = clr + y * nBurnPitch, *f = fr + y * nBurnPitch, *row = pBurnDraw + y * nBurnPitch;
+		INT32 R = -1;
+		for (INT32 x = W - 1; x >= W / 2; x--) if (memcmp(a + x * bpp, c + x * bpp, bpp)) { R = x; break; }
+		if (R < W - 128 || R >= W - 1) continue;          // edge must be near the right side
+		for (INT32 x = R + 1; x < W; x++) {
+			INT32 sx = 2 * R + 1 - x; if (sx < 0) break;
+			if (memcmp(f + x * bpp, c + x * bpp, bpp)) continue;      // something in front: keep it
+			if (!memcmp(a + sx * bpp, c + sx * bpp, bpp)) continue;   // nothing to mirror
+			memcpy(row + x * bpp, a + sx * bpp, bpp);
+		}
+	}
+}
+
+// Debounce: the side strips may only switch from showing a picture (mirrored/tiled background)
+// to a flat colour, or to plain black, once the new state has held for 3 frames. Until then the
+// previous strips are kept, so one- or two-frame scene wipes don't flash bars on the sides.
+static void Ssf2twsMaskStrips()
+{
+	static UINT8 *keep = NULL; static INT32 keepsize = 0;
+	static INT32 shown = -1;       // 0 picture, 1 flat colour, 2 black, -1 none (fight / VS / not ready)
+	static INT32 pend = -1, pendn = 0;
+	if (pBurnDraw == NULL || nCpsScreenWidth < 448 + 8) return;
+	const INT32 H = nCpsScreenHeight, bpp = nBurnBpp, side = (nCpsScreenWidth - 384) / 2;
+	// fight (camera active), or a fight phase where the game drops the camera (e.g. Super Combo finish)
+	// Super Combo finish: the game drops the camera (0xFF8ECE = 0) and draws its burst only in the
+	// middle 384 px; stretch the burst to the full width, fighters and HUD unscaled
+	if (CpsRamFF[0x8ece ^ 1] == 0 && CpsRamFF[0x8005 ^ 1] == 4 && CpsRamFF[0x8009 ^ 1] == 10) {
+		shown = -1; pend = -1; pendn = 0; Ssf2twsStretchFinish(); return;
+	}
+	if ((CpsRamFF[0x8ece ^ 1] == 1 && CpsRamFF[0x8005 ^ 1] <= 8) || (CpsRamFF[0x8005 ^ 1] == 4 && CpsRamFF[0x8009 ^ 1] >= 6)) { shown = -1; pend = -1; pendn = 0; Ssf2twsFillFightHoles(); if (CpsRamFF[0x8c4f ^ 1] == 14) Ssf2twsFeiLongFill(); return; }
+	if (Ssf2twsIsVS()) { shown = -1; pend = -1; pendn = 0; return; }
+	Ssf2twsMaskStripsRaw();
+
+	// classify the new strips
+	INT32 st = 1; UINT32 c0 = 0; memcpy(&c0, pBurnDraw, bpp);
+	for (INT32 y = 0; y < H && st != 0; y++) {
+		UINT8 *row = pBurnDraw + y * nBurnPitch;
+		for (INT32 x = 0; x < side; x++) {
+			UINT32 a = 0, b = 0; memcpy(&a, row + x * bpp, bpp); memcpy(&b, row + (side + 384 + x) * bpp, bpp);
+			if (a != c0 || b != c0) { st = 0; break; }
+		}
+	}
+	if (st == 1 && c0 == 0) st = 2;
+
+	INT32 need = 2 * side * bpp * H;
+	if (need > keepsize) { if (keep) BurnFree(keep); keep = (UINT8*)BurnMalloc(need); keepsize = need; shown = -1; }
+	if (!keep) return;
+
+	INT32 hold = 0;
+	if (shown != -1 && st != shown && (shown == 0 || st == 2)) {
+		if (pend == st) pendn++; else { pend = st; pendn = 1; }
+		if (pendn < 3) hold = 1;
+	}
+	if (hold) {          // restore the previously shown strips
+		for (INT32 y = 0; y < H; y++) {
+			UINT8 *row = pBurnDraw + y * nBurnPitch, *k = keep + y * 2 * side * bpp;
+			memcpy(row, k, side * bpp); memcpy(row + (side + 384) * bpp, k + side * bpp, side * bpp);
+		}
+		return;
+	}
+	pend = -1; pendn = 0; shown = st;
+	for (INT32 y = 0; y < H; y++) {
+		UINT8 *row = pBurnDraw + y * nBurnPitch, *k = keep + y * 2 * side * bpp;
+		memcpy(k, row, side * bpp); memcpy(k + side * bpp, row + (side + 384) * bpp, side * bpp);
+	}
+}
