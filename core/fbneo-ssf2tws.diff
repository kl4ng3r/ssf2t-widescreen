+// ---- Wide scroll1 (game layer 1) ----
+// Layer 1 uses the 8x8 scroll layer, whose tile map is only 512 px wide: exactly the width of the
+// 16:9 view, so the game cannot keep columns ready beyond the edges and they appear late (or
+// wrapped from the other side). In fights the game builds that layer from stage data in ROM
+// (256 px blocks -> 32 px chunks -> 4x4 tiles, see 0xCD550 / 0xCD634), so the side columns are
+// computed straight from that data into a 1024 px wide map. The columns of the original 384 px
+// window always come from the game's own tile map, and the result is only used while those
+// columns agree with the computed ones (self-check), so it can never show something the game
+// would not have drawn.
+static UINT8 s1wide[128 * 256];
+static INT32 s1on = 0;
+
+static inline UINT16 s1rd16(UINT32 a)
+{
+	a &= 0xfffffe;
+	if (a < nCpsRomLen) return *(UINT16*)(CpsRom + a);
+	if (a >= 0xff0000) return *(UINT16*)(CpsRamFF + (a & 0xfffe));
+	return 0;
+}
+static inline UINT32 s1rd32(UINT32 a) { return ((UINT32)s1rd16(a) << 16) | s1rd16(a + 2); }
+
+// tile map column for stage column w (8 px units, any integer): 64 tiles of (code, attr) words,
+// stored like the hardware map: rows 0-31 then rows 32-63
+static void s1column(INT32 w, UINT8 *out)
+{
+	UINT32 table = s1rd32(0xff8e60);                 // layer 1 object +0x12: block table
+	INT32 wx = w * 8;
+	for (INT32 tr = 0; tr < 64; tr++) {
+		INT32 d6 = tr * 8;
+		UINT32 blk = s1rd16(table + ((d6 & 0x100) >> 5) + ((wx & 0x300) >> 7));
+		UINT32 chunk = s1rd16(0x30e000 + (blk << 7) + ((d6 & 0xe0) >> 4) + ((wx & 0xe0) >> 1));
+		UINT32 t = 0x300000 + (chunk << 6) + ((wx >> 3) & 3) * 16 + (tr & 3) * 4;
+		UINT16 *o = (UINT16*)(out + ((tr & 0x20) << 2) + ((tr & 0x1f) << 2));
+		o[0] = s1rd16(t); o[1] = s1rd16(t + 2);
+	}
+}
+static inline void s1getvram(const UINT8 *base, INT32 c, UINT8 *out)
+{
+	memcpy(out, base + ((c & 63) << 7), 128); memcpy(out + 128, base + 0x2000 + ((c & 63) << 7), 128);
+}
+static inline INT32 s1floordiv(INT32 a, INT32 b) { return (a >= 0) ? a / b : -((-a + b - 1) / b); }
+
+static UINT8 *Ssf2twsScr1(UINT8 *base, INT32 nScrX)
+{
+	CpsScr1Wide = NULL;
+	if (CpsRamFF[0x8ece ^ 1] != 1 || CpsRamFF[0x8005 ^ 1] > 8) return base;      // fights only
+	const INT32 ix = (nScrX >> 3) + 1, ntile = nCpsScreenWidth >> 3, side = (nCpsScreenWidth - 384) >> 4;   // side in tiles (8)
+	// stage column of tile map column fx is fx + 64*k for one k: find it on the middle columns
+	UINT8 v[256], c[256];
+	INT32 bestk = 0, best = -1, total = 0;
+	for (INT32 k = -8; k <= 8; k++) {
+		INT32 ok = 0; total = 0;
+		for (INT32 x = side + 2; x < ntile - side - 2; x += 3) {
+			INT32 fx = ix + x;
+			s1getvram(base, fx, v); s1column(fx + 64 * k, c);
+			for (INT32 i = 0; i < 64; i++) { total++; ok += !memcmp(v + i * 4, c + i * 4, 4); }
+		}
+		if (ok > best) { best = ok; bestk = k; }
+	}
+	if (best * 100 < total * 97) { s1on = 0; return base; }   // data doesn't match: leave the game's map alone
+	s1on = 1;
+	for (INT32 x = -1; x < ntile; x++) {
+		INT32 fx = ix + x;
+		UINT8 *col = s1wide + ((fx & 127) << 8);
+		if (x >= side && x < ntile - side) s1getvram(base, fx, col);   // original window: the game's map
+		else s1column(fx + 64 * bestk, col);                            // sides: from the stage data
+	}
+	CpsScr1Wide = s1wide;
+	return base;
+}
+
+static INT32 DrvExit();
+static INT32 Ssf2twsExit()
+{
+	CpsScr1Hook = NULL; CpsScr1Wide = NULL;
+	return DrvExit();
+}
+
+static INT32 Ssf2twsInit()
+{
+	INT32 nRet = Ssf2tInit();
+	if (nRet == 0) { Ssf2twsApplyPatches(); CpsScr1Hook = Ssf2twsScr1; CpsScr1Wide = NULL; }
+	return nRet;
+}
