+// Force the game's "Demo Sound" option on (attract mode with music and effects) by setting
+// the RAM copy of the option that the game checks at run time (0xFF82DD). The EEPROM is left
+// untouched, so the service menu still shows the stored value.
+static void Ssf2twsDemoSound()
+{
+	if (CpsRamFF[0x82dd ^ 1] == 0) CpsRamFF[0x82dd ^ 1] = 1;
+}
+
+static INT32 Ssf2twsFrame()
+{
+	Ssf2twsDemoSound();
+	INT32 nRet = Cps2Frame();
+	Ssf2twsMaskStrips();
+	return nRet;
+}
