+	nWsFrame = nWsFloorFrame = 0;
 
 	SoundProtAddressStart = 0;
 	SoundProtAddressEnd = 0;
@@ -1236,6 +1282,16 @@ INT32 TUnitDraw()
 	// TMS34010 renders scanlines direct to pTransDraw
 	BurnTransferCopy(DrvPaletteB);
 
+	if (TUnitWide && pBurnDraw) {
+		// widescreen: black side strips on lines that do not show the court
+		for (INT32 y = 0; y < nScreenHeight && y < 256; y++) {
+			if (nWsLineCourt[y]) continue;
+			UINT8 *row = pBurnDraw + y * nBurnPitch;
+			memset(row, 0, TUNIT_WS_OFF * nBurnBpp);
+			memset(row + (TUNIT_WS_OFF + TUNIT_SCREEN_WIDTH) * nBurnBpp, 0, (nScreenWidth - TUNIT_WS_OFF - TUNIT_SCREEN_WIDTH) * nBurnBpp);
+		}
+	}
+
 	return 0;
 }
 
@@ -1247,6 +1303,7 @@ static void HandleDCSIRQ(INT32 line)
 INT32 TUnitFrame()
 {
 	if (nTUnitReset) TUnitDoReset();
+	nWsFrame++;
 
 	MakeInputs();
 
@@ -1352,6 +1409,10 @@ INT32 TUnitScan(INT32 nAction, INT32 *pnMin)
 		SCAN_VAR(JdreddpProtTable);
 
 		SCAN_VAR(nExtraCycles);
+		if (TUnitWide) {
+			SCAN_VAR(nWsFrame);
+			SCAN_VAR(nWsFloorFrame);
+		}
 
 		service.Scan();
 	}
