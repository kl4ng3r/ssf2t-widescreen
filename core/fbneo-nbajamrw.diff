@@ -383,6 +383,16 @@ static void TUnitDmaWrite(UINT32 address, UINT16 value)
     dma_state->botclip = nDMA[DMA_BOTCLIP] & 0x1ff;
     dma_state->leftclip = nDMA[DMA_LEFTCLIP] & 0x3ff;
     dma_state->rightclip = nDMA[DMA_RIGHTCLIP] & 0x3ff;
+    if (TUnitWide) {
+        // widescreen: the court floor is the only thing drawn as 512x1 lines at x 0 (patched
