@@ -67,6 +67,11 @@ UINT8 TUnitIsMK2 = 0;
 UINT8 TUnitIsNbajam = 0;
 UINT8 TUnitIsNbajamp = 0;
 UINT8 TUnitIsNbajamTe = 0;
+UINT8 TUnitWide = 0;          // widescreen hack (nbajamrw)
+static UINT32 nWsFrame = 0;      // emulated frame counter
+static UINT32 nWsFloorFrame = 0; // last frame in which the court floor was drawn (+1; 0 = never)
+static UINT8 nWsLineCourt[256];        // per screen line: shown full width
+static void TUnitWsApplyPatches();
 UINT8 TUnitIsJdreddp = 0;
 
 static INT32 vb_start = 0;
@@ -537,6 +542,20 @@ static INT32 ScanlineRender(INT32 line, TMS34010Display *info)
 
 	if (!info->enabled) heblnk = hsblnk; // blank line!
 
+	nWsLineCourt[line] = 0;
+	if (TUnitWide && info->enabled) {
+		// widescreen: the whole 512-pixel VRAM row (the game's 400-pixel picture is columns 56-455)
+		// Only the court is drawn full width; other screens are 400 pixels wide with stale or
+		// partial graphics beside them, so their side strips are shown black.
+		// (palette entry 0 is not always black, so TUnitDraw blacks them out after the colour conversion)
+		// the court floor was drawn this frame or in the last two (the picture shown is the one
+		// drawn in the previous frame; screen shakes and high shots move it between VRAM pages)
+		nWsLineCourt[line] = nWsFloorFrame && (nWsFrame - (nWsFloorFrame - 1)) <= 2;
+		for (INT32 x = 0; x < nScreenWidth; x++)
+			dest[x] = BURN_ENDIAN_SWAP_INT16(src[x] & BURN_ENDIAN_SWAP_INT16(0x7FFF));
+		return 0;
+	}
+
 	if ((hsblnk - heblnk) < nScreenWidth) {
 		for (INT32 x = 0; x < nScreenWidth; x++) {
 			dest[x] = 0;
@@ -1172,11 +1191,36 @@ INT32 TUnitInit()
 
 	GenericTilesInit();
 
+	if (TUnitWide) TUnitWsApplyPatches();
+
 	TUnitDoReset();
 
 	return 0;
 }
 
+// ---- Widescreen hack (nbajamrw): game-code patches, verified against the original words first.
+// If any word does not match (different ROM revision), nothing is patched.
+struct WsPatch { UINT32 addr; UINT16 orig; UINT16 val; };
+#include "nbajamrw_patches.h"
+
+static void TUnitWsApplyPatches()
+{
+	INT32 n = 0, bad = 0;
+	for (INT32 i = 0; NbajamrwPatches[i].addr; i++, n++) {
+		UINT8 *w = DrvBootROM + ((NbajamrwPatches[i].addr - 0xff800000) >> 3);
+		if ((w[0] | (w[1] << 8)) != NbajamrwPatches[i].orig) {
+			bprintf(PRINT_ERROR, _T("nbajamrw: mismatch at %08x: %02x%02x\n"), NbajamrwPatches[i].addr, w[1], w[0]);
+			bad++;
+		}
+	}
+	if (bad) { bprintf(PRINT_ERROR, _T("nbajamrw: %d of %d patch sites do not match, game patches skipped\n"), bad, n); return; }
+	for (INT32 i = 0; NbajamrwPatches[i].addr; i++) {
+		UINT8 *w = DrvBootROM + ((NbajamrwPatches[i].addr - 0xff800000) >> 3);
+		w[0] = NbajamrwPatches[i].val & 0xff; w[1] = NbajamrwPatches[i].val >> 8;
+	}
+	bprintf(PRINT_NORMAL, _T("nbajamrw: applied %d widescreen patch words\n"), n);
+}
